{
  "name": "bamt-next",
  "version": "2.3.0",
  "private": true,
  "description": "Blue Archive Macro Tool rebuilt with Electron, React, TypeScript, and a native Windows backend.",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "predev": "cargo build --manifest-path rust-backend/Cargo.toml",
    "dev": "concurrently -k \"tsc -p tsconfig.node.json --watch\" \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 dist-electron/electron/main.js && electron .\"",
    "build": "tsc -p tsconfig.node.json && vite build",
    "predist": "cargo build --release --manifest-path rust-backend/Cargo.toml",
    "dist": "npm run build && electron-builder --win portable",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "preview": "vite --host 127.0.0.1",
    "electron": "electron ."
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "concurrently": "^9.1.0",
    "electron": "^37.2.0",
    "electron-builder": "^24.13.3",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "com.bamt.next",
    "productName": "BAMT Next",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "tools/AutoHotkey",
        "to": "AutoHotkey",
        "filter": [
          "AutoHotkey64.exe",
          "license.txt"
        ]
      },
      {
        "from": "rust-backend/target/release",
        "to": "rust-backend",
        "filter": [
          "bamt-rust-backend.exe"
        ]
      }
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "BAMT-Next-${version}-portable.${ext}"
    }
  }
}
